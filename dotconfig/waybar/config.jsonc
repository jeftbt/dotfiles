{
    "layer": "top",
    "position": "top",
    "height": "25",
    "include": [
        "~/.config/waybar/modules.json"
    ],

    "modules-left": ["hyprland/workspaces", "hyprland/mode"],
    "modules-center": ["clock"],
    "modules-right": ["network", "bluetooth", "backlight", "pulseaudio", "battery"]
}
